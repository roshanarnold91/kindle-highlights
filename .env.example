# Copy this file to .env and fill in your own values.
# `docker compose up -d` reads .env automatically.

# --- Required ---
# Random secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value

# Password for the bootstrap admin account (username defaults to "admin").
ADMIN_PASSWORD=change-me

# --- Optional ---
ADMIN_USERNAME=admin

# Host path (or Docker volume) mapped to /data inside the container.
# On Windows with Docker Desktop, use a path like J:/kindle-highlights
DATA_PATH=J:/kindle-highlights

# Port exposed on the host.
APP_PORT=5000

# How long a "remember me" session lasts, in days.
REMEMBER_COOKIE_DURATION_DAYS=30

# Google Books API key for fetching cover art (optional — works without a key
# at low request volumes, but a key raises the rate limit).
GOOGLE_BOOKS_API_KEY=

# App-wide SMTP fallback used for any user who hasn't configured their own
# SMTP settings. Leave blank to require every user to configure their own.
APP_SMTP_SERVER=
APP_SMTP_PORT=587
APP_SMTP_EMAIL=
APP_SMTP_PASSWORD=
APP_SMTP_USE_TLS=true
